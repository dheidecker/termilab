# Android (Capacitor): build outputs. mobile/android/ has its own .gitignore too.
dist-mobile/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/app/src/main/assets/public/
# nodejs-mobile runtime: ~135 MB, fetched by scripts/fetch-libnode.js (pinned sha256)
